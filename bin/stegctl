#!/usr/bin/env python3
"""stegctl: stegOS Runtime Orchestrator.

Manages the lifecycle of packages installed in stegOS groups.
"""

import argparse
import logging
import sys

from steglib.constants import VERSION
from steglib.client import StegClient

from steglib.cli_utils import setup_cli, init_cli_client

def main():
    """Main entry point for stegctl."""
    parser, parent_parser, formatter_class = setup_cli(
        description="stegOS Runtime Orchestrator",
        version_str=f"stegctl {VERSION}"
    )
    
    subparsers = parser.add_subparsers(dest="action", required=True, title="commands", description="Action to perform")
    
    actions = {
        "start": "Start one or more packages",
        "stop": "Stop running packages",
        "restart": "Restart packages",
        "status": "Check the status of packages",
        "logs": "View logs from package containers"
    }
    
    for act, help_text in actions.items():
        kwargs = {"help": help_text, "formatter_class": formatter_class, "parents": [parent_parser]}
        p = subparsers.add_parser(act, **kwargs)
        p.add_argument("package", nargs="?", help="Specific package to perform action on (defaults to all)")
        p.add_argument("--group", help="Target group (optional if only one exists)")
        p.add_argument("--if-created", action="store_true", help=argparse.SUPPRESS)
        if act == "logs":
            p.add_argument("-f", "--follow", action="store_true", help="Follow log output")
        
    args = parser.parse_args()
    client = init_cli_client(args)
    
    try:
        action = args.action
        payload = {
            "ctl_action": action,
            "package": args.package,
            "group": args.group,
            "if_created": args.if_created,
            "verbose": args.verbose
        }
        if action == "logs":
            payload["follow"] = args.follow
            
        result = client.call_interactive("ctl.execute", payload)
        
        if action == "status":
            if result and isinstance(result, dict):
                from rich.console import Console
                from rich.table import Table
                table = Table(title="Package Status")
                table.add_column("Package", style="cyan", no_wrap=True)
                table.add_column("State", style="magenta")
                table.add_column("Containers (Running/Total)", style="green")
                for pkg, info in result.items():
                    table.add_row(pkg, info.get("state", "unknown"), f"{info.get('running', 0)}/{info.get('total', 0)}")
                Console().print(table)
            else:
                print("No active packages found or status not available.")
        elif action in ["start", "stop", "restart"]:
            pkg_str = f"'{args.package}'" if args.package else "all packages"
            print(f"\n[+] Successfully executed '{action}' on {pkg_str}.")
    except Exception as e:
        if getattr(e, 'details', None):
            if args.verbose:
                logging.error(f"{e}\nDetails:\n{e.details}")
            else:
                logging.error(f"{e} (run with --verbose for logs)")
        else:
            logging.error(f"{e}")
        sys.exit(1)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAborted by user.")
        sys.exit(130)
