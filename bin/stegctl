#!/usr/bin/env python3
"""stegctl: stegOS Runtime Orchestrator.

Manages the lifecycle of packages installed in stegOS groups.
"""

import argparse
import logging
import sys

from steglib.constants import VERSION
from steglib.client import StegClient

def main():
    """Main entry point for stegctl."""
    try:
        from rich_argparse import RichHelpFormatter
        formatter_class = RichHelpFormatter
    except ImportError:
        formatter_class = argparse.HelpFormatter

    parent_parser = argparse.ArgumentParser(add_help=False)
    parent_parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose output")
    parent_parser.add_argument("--daemon-url", help="URL of the stegd daemon (default: unix:///run/stegos/stegos.sock or STEGOS_DAEMON_URL)")

    parser = argparse.ArgumentParser(description="stegOS Runtime Orchestrator", formatter_class=formatter_class, parents=[parent_parser])
    parser.add_argument('--version', action='version', version=f'stegctl {VERSION}')
    
    subparsers = parser.add_subparsers(dest="action", required=True, title="commands", description="Action to perform")
    
    actions = {
        "start": "Start one or more packages",
        "stop": "Stop running packages",
        "restart": "Restart packages",
        "status": "Check the status of packages",
        "logs": "View logs from package containers"
    }
    
    for act, help_text in actions.items():
        kwargs = {"help": help_text, "formatter_class": formatter_class, "parents": [parent_parser]}
        if act == "logs":
            kwargs["aliases"] = ["log"]
        p = subparsers.add_parser(act, **kwargs)
        p.add_argument("package", nargs="?", help="Specific package to perform action on (defaults to all)")
        p.add_argument("--group", help="Target group (optional if only one exists)")
        p.add_argument("--if-created", action="store_true", help=argparse.SUPPRESS)
        
    args = parser.parse_args()
    
    log_level = logging.DEBUG if args.verbose else logging.INFO
    logging.basicConfig(level=log_level, format="%(message)s")
    
    client = StegClient(url=args.daemon_url)
    try:
        action = "logs" if args.action == "log" else args.action
        client.call_interactive("ctl.execute", {
            "ctl_action": action,
            "package": args.package,
            "group": args.group,
            "if_created": args.if_created,
            "verbose": args.verbose
        })
        
        if action in ["start", "stop", "restart"]:
            pkg_str = f"'{args.package}'" if args.package else "all packages"
            print(f"\n[+] Successfully executed '{action}' on {pkg_str}.")
    except Exception as e:
        logging.error(f"Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAborted by user.")
        sys.exit(130)
