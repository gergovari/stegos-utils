#!/usr/bin/env python3
"""
stegctl: stegOS Runtime Orchestrator.
Manages the lifecycle of packages installed in stegOS groups.
"""

import argparse
import hashlib
import json
import os
import subprocess
import sys

import yaml

from steglib.constants import VERSION, PERSISTENT_DIR, BACKEND_DIR, STATE_FILENAME
from steglib.group import GroupManager
from steglib import state

class BackendBase:
    """Abstract base class for runtime backends."""
    def __init__(self, pkg, pkg_path, group_dir):
        self.pkg = pkg
        self.pkg_path = pkg_path
        self.group_dir = group_dir

    def execute(self, action, extra_args):
        """Execute a lifecycle action."""
        raise NotImplementedError

class DockerComposeBackend(BackendBase):
    """Docker Compose runtime backend."""
    
    def _sync_docker_cache(self, compose_file, action):
        """
        Synchronize docker images with the local group cache to allow offline starts.
        
        Args:
            compose_file (str): Path to the docker-compose.yml file.
            action (str): Either 'pre-start' (load) or 'post-start' (save).
        """
        try:
            with open(compose_file, 'r') as f:
                compose_data = yaml.safe_load(f)
        except (OSError, yaml.YAMLError) as e:
            print(f"Warning: Failed to read {compose_file} for caching: {e}")
            return
            
        images = []
        services = compose_data.get("services", {})
        if services:
            for svc_name, svc_data in services.items():
                if isinstance(svc_data, dict) and "image" in svc_data:
                    images.append(svc_data["image"])
                
        if not images:
            return
            
        # Use the group directory for caching
        cache_dir = os.path.join(self.group_dir, DOCKER_CACHE_DIR)
        os.makedirs(cache_dir, exist_ok=True)
        
        if action == "pre-start":
            for image in images:
                safe_name = hashlib.md5(image.encode()).hexdigest() + ".tar"
                cache_path = os.path.join(cache_dir, safe_name)
                if os.path.isfile(cache_path):
                    check = subprocess.run(["docker", "image", "inspect", image], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    if check.returncode != 0:
                        print(f"Loading cached image '{image}' from group cache...")
                        subprocess.run(["docker", "load", "-i", cache_path])
        elif action == "post-start":
            for image in images:
                safe_name = hashlib.md5(image.encode()).hexdigest() + ".tar"
                cache_path = os.path.join(cache_dir, safe_name)
                if not os.path.isfile(cache_path):
                    print(f"Caching image '{image}' to group cache...")
                    subprocess.run(["docker", "save", "-o", cache_path, image])
                    
    def execute(self, action, extra_args):
        """
        Handle docker-compose specific actions for a package.
        
        Args:
            action (str): The lifecycle action to perform.
            extra_args (list): Additional arguments to append to the command.
        """
        compose_file = os.path.join(self.pkg_path, "docker-compose.yml")
        if not os.path.isfile(compose_file):
            print(f"[{self.pkg}] Error: docker-compose.yml missing.")
            return
        
        cmd = ["docker", "compose", "-f", compose_file]
        if action == "start":
            self._sync_docker_cache(compose_file, "pre-start")
            cmd.extend(["up", "-d", "--remove-orphans"])
        elif action == "stop":
            # Check if the service has any containers; if not, skip stopping
            check_cmd = ["docker", "compose", "-f", compose_file, "ps", "-q", "-a"]
            try:
                result = subprocess.run(check_cmd, capture_output=True, text=True, check=True)
                if not result.stdout.strip():
                    # No containers exist, nothing to stop
                    return
            except subprocess.CalledProcessError:
                pass # If check fails, fall through to down just in case
            
            cmd.append("down")
        elif action == "status":
            cmd.append("ps")
        elif action == "logs":
            cmd.append("logs")
        else:
            print(f"[{self.pkg}] Unknown action '{action}'")
            return
            
        if extra_args:
            cmd.extend(extra_args)
            
        try:
            print(f"[{self.pkg}] Executing docker-compose {action}...")
            subprocess.run(cmd, check=True)
            if action == "start":
                self._sync_docker_cache(compose_file, "post-start")
        except subprocess.CalledProcessError as e:
            print(f"[{self.pkg}] Error: Command failed with code {e.returncode}")

BACKENDS = {
    "docker-compose": DockerComposeBackend,
}

class LifecycleManager:
    """Manages the lifecycle (start, stop, etc.) of stegOS packages within a group."""

    def __init__(self, group_prefix):
        """Initialize the LifecycleManager with a specific group."""
        self.group_name = GroupManager.resolve(group_prefix)
        self.cont_dir = os.path.join(PERSISTENT_DIR, self.group_name)

    def execute(self, action, package_name=None, extra_args=None):
        """
        Execute an action on a specific package or all packages in the group.
        
        Args:
            action (str): The lifecycle action to perform (e.g., start, stop).
            package_name (str, optional): Specific package to target.
            extra_args (list, optional): Additional arguments for the backend deployer.
        """
        if extra_args is None:
            extra_args = []
            
        if not os.path.isdir(self.cont_dir):
            print(f"Error: Group directory '{self.cont_dir}' not found.")
            sys.exit(1)

        if package_name:
            target_path = os.path.join(self.cont_dir, package_name)
            if os.path.isdir(target_path):
                packages = [package_name]
            else:
                matched = []
                for d in os.listdir(self.cont_dir):
                    try:
                        st = state.read_state(self.group_name, d)
                        if st and st.get("package") == package_name:
                            matched.append(d)
                    except (json.JSONDecodeError, OSError, KeyError):
                        pass
                
                if len(matched) == 1:
                    packages = matched
                elif len(matched) > 1:
                    print(f"Error: Multiple instances of '{package_name}' found. Please specify instance ID instead: {matched}")
                    sys.exit(1)
                else:
                    print(f"Error: No instance or package named '{package_name}' found in group '{self.group_name}'.")
                    sys.exit(1)
        else:
            packages = os.listdir(self.cont_dir)
        
        for pkg in packages:
            pkg_path = os.path.join(self.cont_dir, pkg, BACKEND_DIR)
            if not os.path.isdir(pkg_path):
                continue
                
            try:
                st = state.read_state(self.group_name, pkg)
            except (json.JSONDecodeError, OSError, KeyError):
                st = None

            if not st:
                if package_name:
                    print(f"[{pkg}] No state file found. Was it installed with stegpkg?")
                continue

            if action == "start":
                enabled_caps = st.get("enabled_caps", {})
                for cap, provs in enabled_caps.items():
                    if not isinstance(provs, list):
                        provs = [provs]
                    for p in provs:
                        print(f"[{pkg}] Ensuring provider '{p}' is started...")
                        if p != pkg:
                            self.execute(action, p, extra_args)

            deployer = st.get("deployer")
            backend_cls = BACKENDS.get(deployer)
            if backend_cls:
                backend = backend_cls(pkg, pkg_path, self.cont_dir)
                backend.execute(action, extra_args)
            else:
                print(f"[{pkg}] Warning: Unknown deployer '{deployer}'")

def main():
    """Main entry point for stegctl."""
    parser = argparse.ArgumentParser(description="stegOS Runtime Orchestrator")
    parser.add_argument('--version', action='version', version=f'stegctl {VERSION}')
    parser.add_argument("action", choices=["start", "stop", "restart", "status", "logs"], help="Action to perform")
    parser.add_argument("package", nargs="?", help="Specific package to perform action on (defaults to all)")
    parser.add_argument("--group", help="Target group (optional if only one exists)")
    parser.add_argument("extra_args", nargs=argparse.REMAINDER, help="Additional arguments to pass to docker-compose")
    
    args = parser.parse_args()
    
    manager = LifecycleManager(args.group)
    
    if args.action == "restart":
        manager.execute("stop", args.package, args.extra_args)
        manager.execute("start", args.package, args.extra_args)
    else:
        manager.execute(args.action, args.package, args.extra_args)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAborted by user.")
        sys.exit(130)
