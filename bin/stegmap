#!/usr/bin/env python3
"""stegmap — stegOS Drive Mapper.

Discovers block devices labeled with the stegOS prefix and bind-mounts
their internal directory structure into the stegOS runtime tree.
"""

import argparse
import logging
import sys

from steglib.client import StegClient

def main():
    parser = argparse.ArgumentParser(description="stegOS Drive Mapper Utility")
    subparsers = parser.add_subparsers(dest="command", required=True, help="Available commands")
    
    # Mount command
    mount_parser = subparsers.add_parser("mount", help="Discover and mount all stegOS-labeled drives")
    
    # Unmount command
    unmount_parser = subparsers.add_parser("unmount", help="Unmount all stegOS bind mounts")
    
    # Verbosity
    parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose logging")
    parser.add_argument("--daemon-url", help="URL of the stegd daemon (default: unix:///run/stegos/stegos.sock or STEGOS_DAEMON_URL)")
    
    args = parser.parse_args()
    
    log_level = logging.INFO
    if args.verbose:
        log_level = logging.DEBUG
        
    logging.basicConfig(
        level=log_level,
        format="[%(levelname)s] %(message)s"
    )
    
    client = StegClient(url=args.daemon_url)
    try:
        args_dict = vars(args).copy()
        if "command" in args_dict:
            del args_dict["command"]
        client.call_interactive("map.execute", {
            "map_action": args.command,
            **args_dict
        })
    except Exception as e:
        logging.fatal(f"Error executing command '{args.command}': {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
