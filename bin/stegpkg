#!/usr/bin/env python3
"""stegpkg — stegOS Package Manager.

Manages the lifecycle of application packages within stegOS groups.
"""

import argparse
import logging
import sys

from steglib.constants import VERSION
from steglib.client import StegClient

from steglib.cli_utils import setup_cli, init_cli_client

def main():
    parser, parent_parser, formatter_class = setup_cli(
        description="stegOS Package Manager",
        version_str=f"stegpkg {VERSION}"
    )
    
    subparsers = parser.add_subparsers(dest="command", required=True, title="commands", description="Action to perform")

    # -- install ------------------------------------------------------------
    p = subparsers.add_parser("install", help="Install a package", formatter_class=formatter_class)
    p.add_argument("packages", nargs="+", help="Package(s) to install")
    p.add_argument("--id", help="Explicit instance ID")
    p.add_argument("--group", help="Target group")
    p.add_argument("--repo", help="Disambiguate by repository name")
    p.add_argument("--config", help="Path to JSON config overrides")
    p.add_argument("--reconfigure", action="store_true", help="Re-prompt for all values")
    p.add_argument("--non-interactive", action="store_true", help="Never prompt; use defaults or abort")

    # -- reconfigure --------------------------------------------------------
    p = subparsers.add_parser("reconfigure", help="Regenerate configuration", formatter_class=formatter_class)
    p.add_argument("instance_ids", nargs="*", help="Instance(s) to reconfigure (default: all)")
    p.add_argument("--group", help="Target group")

    # -- remove -------------------------------------------------------------
    p = subparsers.add_parser("remove", help="Remove a package instance", formatter_class=formatter_class)
    p.add_argument("instance_ids", nargs="+", help="Instance(s) to remove")
    p.add_argument("--group", help="Target group")
    p.add_argument("--purge", action="store_true", help="Also delete persistent data")
    p.add_argument("--cascade", action="store_true", help="Auto-reconfigure dependents")

    # -- upgrade ------------------------------------------------------------
    p = subparsers.add_parser("upgrade", help="Upgrade packages", formatter_class=formatter_class)
    p.add_argument("instance_ids", nargs="*", help="Instance(s) to upgrade (default: all)")
    p.add_argument("--group", help="Target group")

    # -- update -------------------------------------------------------------
    p = subparsers.add_parser("update", help="Update app repositories via git pull", formatter_class=formatter_class)
    p.add_argument("--group", help="Target group")

    # -- list ---------------------------------------------------------------
    p = subparsers.add_parser("list", help="List installed packages", formatter_class=formatter_class)
    p.add_argument("--group", help="Target group")

    # -- clean --------------------------------------------------------------
    p = subparsers.add_parser("clean", help="Remove unmanaged instance directories", formatter_class=formatter_class)
    p.add_argument("--group", help="Target group")
    p.add_argument("-y", "--yes", action="store_true", help="Automatic yes to prompts")

    args = parser.parse_args()
    client = init_cli_client(args)
    try:
        args_dict = vars(args).copy()
        if "command" in args_dict:
            del args_dict["command"]
            
        client.call_interactive(f"pkg.{args.command}", args_dict)
    except Exception as e:
        if getattr(e, 'details', None):
            if args.verbose:
                logging.error(f"{e}\nDetails:\n{e.details}")
            else:
                logging.error(f"{e} (run with --verbose for logs)")
        else:
            logging.error(f"{e}")
        sys.exit(1)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAborted by user.")
        sys.exit(130)
