#!/usr/bin/env python3
"""stegpkg — stegOS Package Manager.

Manages the lifecycle of application packages within stegOS groups.
"""

import argparse
import logging
import sys

from steglib.constants import VERSION
from steglib.engine import PackageEngine
from steglib.manager import PackageManager

def cli_interactive_cb(message, choices=None, default=None, multiple=False):
    """Simple CLI callback for interactive prompts."""
    if multiple:
        # Expected comma separated choices
        default_str = default if default else ""
        print(f"\n{message}")
        ans = input(f"Select choices (comma-separated, or empty to skip) [default: {default_str}]: ").strip()
        if not ans and default_str:
            ans = default_str
        if ans:
            return [x.strip() for x in ans.split(",") if x.strip()]
        return []
    
    if choices:
        print(f"\n{message}")
        for i, choice in enumerate(choices, 1):
            print(f"  {i}. {choice}")
        default_str = f" [default: {default}]" if default else ""
        while True:
            ans = input(f"Select [1-{len(choices)}]{default_str}: ").strip()
            if not ans and default:
                return default
            if ans.isdigit() and 1 <= int(ans) <= len(choices):
                return choices[int(ans) - 1]
            # check if they typed the choice itself
            if ans in choices:
                return ans
            print("Invalid selection. Try again.")
    else:
        default_str = f" [default: {default}]" if default else ""
        ans = input(f"{message}{default_str}: ").strip()
        return ans if ans else default

def main():
    """Main entry point for stegpkg."""
    parser = argparse.ArgumentParser(description="stegOS Package Manager")
    parser.add_argument("--version", action="version", version=f"stegpkg {VERSION}")
    parser.add_argument("-v", "--verbose", action="store_true", help="Enable verbose logging")
    
    subparsers = parser.add_subparsers(dest="command", required=True)

    # -- install ------------------------------------------------------------
    p = subparsers.add_parser("install", help="Install a package")
    p.add_argument("packages", nargs="+", help="Package(s) to install")
    p.add_argument("--id", help="Explicit instance ID")
    p.add_argument("--group", help="Target group")
    p.add_argument("--repo", help="Disambiguate by repository name")
    p.add_argument("--config", help="Path to JSON config overrides")
    p.add_argument("--reconfigure", action="store_true", help="Re-prompt for all values")
    p.add_argument("--non-interactive", action="store_true", help="Never prompt; use defaults or abort")

    # -- reconfigure --------------------------------------------------------
    p = subparsers.add_parser("reconfigure", help="Regenerate configuration")
    p.add_argument("instance_ids", nargs="*", help="Instance(s) to reconfigure (default: all)")
    p.add_argument("--group", help="Target group")

    # -- remove -------------------------------------------------------------
    p = subparsers.add_parser("remove", help="Remove a package instance")
    p.add_argument("instance_ids", nargs="+", help="Instance(s) to remove")
    p.add_argument("--group", help="Target group")
    p.add_argument("--purge", action="store_true", help="Also delete persistent data")
    p.add_argument("--cascade", action="store_true", help="Auto-reconfigure dependents")

    # -- upgrade ------------------------------------------------------------
    p = subparsers.add_parser("upgrade", help="Upgrade packages")
    p.add_argument("instance_ids", nargs="*", help="Instance(s) to upgrade (default: all)")
    p.add_argument("--group", help="Target group")

    # -- update -------------------------------------------------------------
    p = subparsers.add_parser("update", help="Update app repositories via git pull")
    p.add_argument("--group", help="Target group")

    # -- list ---------------------------------------------------------------
    p = subparsers.add_parser("list", help="List installed packages")
    p.add_argument("--group", help="Target group")

    # -- clean --------------------------------------------------------------
    p = subparsers.add_parser("clean", help="Remove unmanaged instance directories")
    p.add_argument("--group", help="Target group")
    p.add_argument("-y", "--yes", action="store_true", help="Automatic yes to prompts")

    args = parser.parse_args()
    
    log_level = logging.DEBUG if args.verbose else logging.INFO
    logging.basicConfig(level=log_level, format="%(message)s")
    
    try:
        engine = PackageEngine(args.group)
        manager = PackageManager(engine)
        
        interactive_cb = cli_interactive_cb if sys.stdin.isatty() else None

        if args.command == "install":
            manager.install(
                args.packages, args.repo, args.config, args.reconfigure,
                args.non_interactive, args.id, interactive_cb
            )
        elif args.command == "reconfigure":
            manager.reconfigure(args.instance_ids, interactive_cb)
        elif args.command == "remove":
            manager.remove(args.instance_ids, args.purge, args.cascade, interactive_cb)
        elif args.command == "upgrade":
            manager.upgrade(args.instance_ids, interactive_cb)
        elif args.command == "update":
            manager.update()
        elif args.command == "list":
            manager.list_packages()
        elif args.command == "clean":
            manager.clean(args.yes, interactive_cb)
            
    except Exception as e:
        logging.error(f"Error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAborted by user.")
        sys.exit(130)
