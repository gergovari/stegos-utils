#!/usr/bin/env python3
"""stegpkg — stegOS Package Manager.

Manages the lifecycle of application packages within stegOS groups:
installing, configuring, upgrading, and removing containerized services
that are deployed via pluggable backends (currently docker-compose).

Usage:
    stegpkg install <package> [--group GROUP] [--config FILE]
    stegpkg reconfigure [INSTANCE ...] [--group GROUP]
    stegpkg remove <instance> [--purge] [--cascade] [--group GROUP]
    stegpkg upgrade [INSTANCE ...] [--group GROUP]
    stegpkg update [--group GROUP]
    stegpkg list [--group GROUP]
"""

# ---------------------------------------------------------------------------
# Standard library
# ---------------------------------------------------------------------------
import argparse
import json
import os
import shutil
import subprocess
import sys
import uuid

# ---------------------------------------------------------------------------
# Third-party
# ---------------------------------------------------------------------------
import jsonschema
import yaml
from jinja2 import Environment, FileSystemLoader

# ---------------------------------------------------------------------------
# stegOS shared library
# ---------------------------------------------------------------------------
from steglib import state
from steglib.constants import (
    BACKEND_DIR,
    CONF_DIR,
    GLOBAL_CONF_FILENAME,
    PERSISTENT_DIR,
    REPOS_DIR,
    VERSION,
)
from steglib.group import GroupManager


# ═══════════════════════════════════════════════════════════════════════════
# Capability Manager
# ═══════════════════════════════════════════════════════════════════════════

class CapabilityManager:
    """Tracks which installed instances provide which capabilities.

    On construction it scans every installed instance in the group,
    reads its manifest, and builds an in-memory registry of
    ``{capability_name: {instance_id: {injector: ...}}}``.
    """

    def __init__(self, engine):
        self._engine = engine
        self._registry = {}
        self._scan()

    # -- public API ---------------------------------------------------------

    def register(self, cap_name, instance_name, injector_rules):
        """Register a provider for the duration of this CLI invocation."""
        self._registry.setdefault(cap_name, {})[instance_name] = {
            "injector": injector_rules,
        }

    def get_providers(self, cap_name):
        """Return ``{instance_id: info}`` for a given capability, or ``{}``."""
        return self._registry.get(cap_name, {})

    # -- internals ----------------------------------------------------------

    def _scan(self):
        """Scan the group directory and populate the registry."""
        group_dir = os.path.join(PERSISTENT_DIR, self._engine.group_name)
        if not os.path.isdir(group_dir):
            return

        for instance_id in os.listdir(group_dir):
            st = state.read_state(self._engine.group_name, instance_id)
            if st is None:
                continue
            pkg_name = st.get("package")
            if not pkg_name:
                continue
            try:
                pkg_dir = self._engine.find_package_dir(pkg_name)
            except SystemExit:
                continue
            manifest = _load_manifest(pkg_dir)
            if manifest is None:
                continue

            for cap in manifest.get("capabilities", {}).get("provides", []):
                name = cap.get("name")
                if name:
                    self.register(name, instance_id, cap.get("injectors", {}))


# ═══════════════════════════════════════════════════════════════════════════
# Configuration Resolver
# ═══════════════════════════════════════════════════════════════════════════

class ConfigResolver:
    """Interactively (or non-interactively) resolves configuration values
    against a JSON Schema definition."""

    @staticmethod
    def resolve(schema, pkg_conf, global_conf, cli_conf,
                reconfigure, non_interactive):
        """Walk the schema properties and collect final values.

        Priority order (highest → lowest):
          1. CLI overrides (``cli_conf``)
          2. Interactive user input (if applicable)
          3. Previously saved values (``pkg_conf``)
          4. Schema defaults

        Returns:
            A dict of resolved configuration values.
        """
        final = {}
        properties = schema.get("properties", {})
        required = set(schema.get("required", []))

        # Determine whether we need to prompt.
        needs_prompt = any(
            key not in cli_conf
            and (reconfigure or key not in pkg_conf)
            and "default" not in prop
            and key not in pkg_conf
            for key, prop in properties.items()
        )

        if needs_prompt and non_interactive:
            print("Error: Missing required configuration values and"
                  " --non-interactive is set.")
            sys.exit(1)

        if needs_prompt:
            print("\n--- Configuration Required ---")

        for key, prop in properties.items():
            # 1. CLI override wins.
            if key in cli_conf:
                final[key] = cli_conf[key]
                continue

            # 2. Keep existing value on non-interactive reconfigure.
            if not reconfigure and key in pkg_conf:
                final[key] = pkg_conf[key]
                continue

            # 3. Compute default.
            default = pkg_conf.get(key, prop.get("default", ""))
            is_req = key in required

            if non_interactive:
                if default != "":
                    final[key] = default
                elif is_req:
                    print(f"Error: Missing required value for '{key}'.")
                    sys.exit(1)
                continue

            # 4. Interactive prompt.
            desc = prop.get("description", "")
            prompt = key
            if desc:
                prompt += f" ({desc})"
            if default != "":
                prompt += f" [default: {default}]"
            prompt += ": "

            while True:
                user_input = input(prompt)
                if not user_input and default != "":
                    val = default
                elif not user_input and is_req:
                    print("This field is required.")
                    continue
                elif not user_input:
                    val = None
                    break
                else:
                    val = user_input

                # Type coercion.
                val_type = prop.get("type", "string")
                if val is not None:
                    try:
                        if val_type == "integer":
                            val = int(val)
                        elif val_type == "number":
                            val = float(val)
                        elif val_type == "boolean":
                            val = str(val).lower() in ("true", "1", "yes", "y")
                    except ValueError:
                        print(f"Invalid type. Expected {val_type}.")
                        continue

                if val is not None:
                    final[key] = val
                break

        if needs_prompt:
            print("------------------------------\n")

        return final


# ═══════════════════════════════════════════════════════════════════════════
# Deployers
# ═══════════════════════════════════════════════════════════════════════════

class DeployerBase:
    """Abstract base class for package deployers."""

    def __init__(self, name, config, pkg_dir, out_dir, env,
                 final_conf, global_conf, manifest, instance_name):
        self.name = name
        self.config = config
        self.pkg_dir = pkg_dir
        self.out_dir = out_dir
        self.env = env
        self.final_conf = final_conf
        self.global_conf = global_conf
        self.manifest = manifest
        self.instance_name = instance_name

    def deploy(self, cap_manager):
        """Deploy the package. Subclasses must implement this."""
        raise NotImplementedError

    def _process_skeleton(self, skeletons):
        """Copy skeleton directory trees into the output directory.

        Files that already exist in the output are never overwritten,
        allowing user customizations to persist across reconfigures.
        """
        for skel in skeletons:
            src = skel.get("src")
            dest = skel.get("dest", "./")
            if not src:
                continue
            src_path = os.path.join(self.pkg_dir, src)
            if not os.path.isdir(src_path):
                print(f"Warning: Skeleton source '{src}' not found.")
                continue
            dest_base = os.path.normpath(os.path.join(self.out_dir, dest))
            if not dest_base.startswith(self.out_dir):
                continue
            for root, _dirs, files in os.walk(src_path):
                rel_dir = os.path.relpath(root, src_path)
                target_dir = dest_base if rel_dir == "." else os.path.join(dest_base, rel_dir)
                os.makedirs(target_dir, exist_ok=True)
                for fname in files:
                    target_file = os.path.join(target_dir, fname)
                    if not os.path.exists(target_file):
                        shutil.copy2(os.path.join(root, fname), target_file)


class DockerComposeDeployer(DeployerBase):
    """Deploys packages via docker-compose template rendering."""

    def deploy(self, cap_manager):
        """Render templates, copy files, inject capability env vars, write state."""
        # Process skeletons first (creates base directory structure).
        skeletons = self.config.get("skeleton", [])
        if skeletons:
            self._process_skeleton(skeletons)

        # Resolve exports from this package's consume declarations.
        exports = self._resolve_exports()

        # Compute injected environment variables and networks from capability providers.
        injected_env = self._compute_injected_env(cap_manager, exports)
        injected_networks = self._compute_injected_networks(cap_manager)

        # Render templates.
        self._render_templates(injected_env, injected_networks)

        # Copy static files.
        self._copy_files()

        # Persist deployer state for stegctl.
        state.write_state(
            # Derive group from out_dir path structure.
            os.path.basename(os.path.dirname(os.path.dirname(self.out_dir))),
            self.instance_name,
            {
                "deployer": "docker-compose",
                "package": self.manifest.get("name"),
                "instance": self.instance_name,
                "enabled_caps": self.final_conf.get("_enabled_capabilities", {}),
            },
        )

    def _resolve_exports(self):
        """Resolve exports declared in consume entries.

        Exports are defined per-consume entry in the manifest, e.g.:
            capabilities:
              consumes:
                - name: reverse-proxy
                  exports:
                    host: "{{ config.subdomain }}.{{ global_config.base_domain }}"
        """
        exports = {}
        consumes = self.manifest.get("capabilities", {}).get("consumes", [])
        for entry in consumes:
            if not isinstance(entry, dict):
                continue
            entry_exports = entry.get("exports", {})
            for key, value in entry_exports.items():
                if isinstance(value, str):
                    tmpl = self.env.from_string(value)
                    exports[key] = tmpl.render(
                        config=self.final_conf,
                        global_config=self.global_conf,
                    )
                else:
                    exports[key] = value
        return exports

    def _compute_injected_env(self, cap_manager, exports):
        """Build the environment variables injected by capability providers."""
        enabled_caps = self.final_conf.get("_enabled_capabilities", {})
        injected_env = {}

        for cap_name, selected in enabled_caps.items():
            providers = cap_manager.get_providers(cap_name)
            if not isinstance(selected, list):
                selected = [selected]

            for prov_id in selected:
                if prov_id not in providers:
                    continue
                prov_info = providers[prov_id]
                injectors = prov_info.get("injector", {})
                dc_rules = injectors.get("docker-compose", {})
                for env_key, env_tmpl in dc_rules.get("env", {}).items():
                    tmpl = self.env.from_string(env_tmpl)
                    injected_env[env_key] = tmpl.render(
                        consumer={"config": self.final_conf, "exports": exports},
                    )

        return injected_env

    def _compute_injected_networks(self, cap_manager):
        """Build a list of network names injected by capability providers."""
        enabled_caps = self.final_conf.get("_enabled_capabilities", {})
        networks = []

        for cap_name, selected in enabled_caps.items():
            providers = cap_manager.get_providers(cap_name)
            if not isinstance(selected, list):
                selected = [selected]

            for prov_id in selected:
                if prov_id not in providers:
                    continue
                prov_info = providers[prov_id]
                dc_rules = prov_info.get("injector", {}).get("docker-compose", {})
                for net in dc_rules.get("networks", []):
                    if net not in networks:
                        networks.append(net)

        return networks

    def _render_templates(self, injected_env, injected_networks):
        """Render Jinja2 templates into the output directory."""
        templates = self.config.get("templates", [
            {"src": "docker-compose.yml.j2", "dest": "docker-compose.yml"},
        ])
        for entry in templates:
            src = entry.get("src")
            dest = entry.get("dest")
            if not (src and dest):
                continue
            src_path = os.path.join(self.pkg_dir, src)
            if not os.path.exists(src_path):
                print(f"Warning: Template '{src}' not found in package.")
                continue

            with open(src_path, "r") as fh:
                content = fh.read()

            tmpl = self.env.from_string(content)
            rendered = tmpl.render(
                config=self.final_conf,
                global_config=self.global_conf,
            )

            # Dynamically inject capabilities into docker-compose.yml
            if dest == "docker-compose.yml" and (injected_env or injected_networks):
                try:
                    compose_data = yaml.safe_load(rendered)
                    if not isinstance(compose_data, dict):
                        compose_data = {}
                        
                    services = compose_data.get("services", {})
                    for svc_name, svc_data in services.items():
                        if not isinstance(svc_data, dict):
                            continue
                            
                        # Inject Environment Variables
                        if injected_env:
                            env = svc_data.get("environment", {})
                            if isinstance(env, list):
                                # Convert list format to dict format for easier merging
                                new_env = {}
                                for e in env:
                                    if "=" in e:
                                        k, v = e.split("=", 1)
                                        new_env[k] = v
                                env = new_env
                            
                            for k, v in injected_env.items():
                                env[k] = str(v)
                            svc_data["environment"] = env

                        # Inject Networks
                        if injected_networks:
                            svc_nets = svc_data.get("networks", [])
                            if isinstance(svc_nets, dict):
                                svc_nets = list(svc_nets.keys())
                            if not isinstance(svc_nets, list):
                                svc_nets = []
                            
                            for net in injected_networks:
                                if net not in svc_nets:
                                    svc_nets.append(net)
                                    
                            if "default" not in svc_nets:
                                svc_nets.append("default")
                                
                            svc_data["networks"] = svc_nets

                    # Define injected external networks globally
                    if injected_networks:
                        global_nets = compose_data.get("networks", {})
                        if not isinstance(global_nets, dict):
                            global_nets = {}
                        for net in injected_networks:
                            if net not in global_nets:
                                global_nets[net] = {"external": True}
                        compose_data["networks"] = global_nets

                    rendered = yaml.dump(compose_data, default_flow_style=False, sort_keys=False)
                except Exception as e:
                    print(f"Warning: Failed to dynamically inject capabilities into {dest}: {e}")

            dest_path = os.path.join(self.out_dir, os.path.normpath(dest))
            os.makedirs(os.path.dirname(dest_path) or ".", exist_ok=True)
            with open(dest_path, "w") as fh:
                fh.write(rendered)

    def _copy_files(self):
        """Copy static files declared in the deployer config."""
        for entry in self.config.get("files", []):
            src = entry.get("src")
            dest = entry.get("dest")
            if not (src and dest):
                continue
            src_path = os.path.join(self.pkg_dir, src)
            if not os.path.exists(src_path):
                print(f"Warning: File '{src}' not found in package.")
                continue
            dest_path = os.path.join(self.out_dir, os.path.normpath(dest))
            os.makedirs(os.path.dirname(dest_path) or ".", exist_ok=True)
            shutil.copy2(src_path, dest_path)


# ═══════════════════════════════════════════════════════════════════════════
# Package Engine
# ═══════════════════════════════════════════════════════════════════════════

class PackageEngine:
    """Core engine for package operations within a single stegOS group."""

    def __init__(self, group_prefix):
        self.group_name = GroupManager.resolve(group_prefix)
        self.group_dir = os.path.join(PERSISTENT_DIR, self.group_name)
        self.repo_dir = os.path.join(REPOS_DIR, self.group_name)

        os.makedirs(self.group_dir, exist_ok=True)

        self.cap_manager = CapabilityManager(self)

        # Load global configuration (base_domain, timezone, etc.).
        self.global_conf = {}
        gc_path = os.path.join(self.group_dir, GLOBAL_CONF_FILENAME)
        if os.path.isfile(gc_path):
            try:
                with open(gc_path, "r") as fh:
                    self.global_conf = json.load(fh)
            except (json.JSONDecodeError, OSError) as exc:
                print(f"Warning: Failed to read global config: {exc}")

    def find_package_dir(self, pkg_name, target_repo=None):
        """Locate the package directory by name within the repos tree.

        Args:
            pkg_name: Package name to search for (matches directory name
                      containing a ``manifest.yml``).
            target_repo: Optional repository name to disambiguate.

        Returns:
            Absolute path to the package directory.

        Raises:
            SystemExit: If the package is not found or is ambiguous.
        """
        if not os.path.isdir(self.repo_dir):
            print(f"Error: Repos directory '{self.repo_dir}' does not exist."
                  " Did you run 'stegmap mount'?")
            sys.exit(1)

        found = []
        for root, _dirs, files in os.walk(self.repo_dir):
            if "manifest.yml" in files and os.path.basename(root) == pkg_name:
                found.append(root)

        if not found:
            print(f"Error: Package '{pkg_name}' not found in repos.")
            sys.exit(1)

        if target_repo:
            found = [p for p in found if f"/{target_repo}/" in p]
            if not found:
                print(f"Error: Package '{pkg_name}' not found"
                      f" in repo '{target_repo}'.")
                sys.exit(1)

        if len(found) > 1:
            print(f"Error: Multiple packages named '{pkg_name}' found."
                  " Use --repo to disambiguate.")
            sys.exit(1)

        return found[0]

    def process_package(self, pkg_dir, cli_conf=None, reconfigure=False,
                        non_interactive=False, instance_id=None):
        """Install or reconfigure a package instance.

        This is the central method that handles:
          - Manifest loading and validation
          - Instance naming (singleton enforcement, UUID generation)
          - Interactive capability selection
          - Configuration resolution and schema validation
          - Deployer invocation
          - Capability registration

        Args:
            pkg_dir: Absolute path to the package source directory.
            cli_conf: Optional dict of CLI-provided config overrides.
            reconfigure: If True, re-prompt for all configuration values.
            non_interactive: If True, never prompt — use defaults or abort.
            instance_id: Optional explicit instance ID (for reconfigure).
        """
        if cli_conf is None:
            cli_conf = {}

        manifest = _load_manifest(pkg_dir)
        if manifest is None:
            print(f"Error: Failed to load manifest from '{pkg_dir}'.")
            sys.exit(1)

        pkg_name = manifest.get("name")
        is_singleton = manifest.get("singleton", False)

        # Find existing instances of this package.
        existing = self._find_instances_by_package(pkg_name)

        # Determine instance name.
        instance_name = self._resolve_instance_name(
            pkg_name, instance_id, reconfigure, is_singleton, existing,
        )

        # Load existing config.
        pkg_conf = state.read_conf(self.group_name, instance_name)

        # Parse capabilities consumed by this package.
        consumes = _parse_consumes(manifest)

        # Resolve enabled capabilities (interactive selection).
        enabled_caps = self._resolve_capabilities(
            consumes, pkg_conf, reconfigure, non_interactive,
        )

        # Merge conditional schemas from enabled capabilities.
        config_schema = dict(manifest.get("config_schema", {}))
        for cap_name, cond_schema in manifest.get("conditional_config_schema", {}).items():
            if cap_name in enabled_caps and enabled_caps[cap_name]:
                if self.cap_manager.get_providers(cap_name):
                    if "properties" in cond_schema:
                        config_schema.setdefault("properties", {}).update(
                            cond_schema["properties"])
                    if "required" in cond_schema:
                        config_schema.setdefault("required", []).extend(
                            cond_schema["required"])

        # Resolve configuration values.
        final_conf = {}
        if config_schema:
            final_conf = ConfigResolver.resolve(
                config_schema, pkg_conf, self.global_conf,
                cli_conf, reconfigure, non_interactive,
            )
            try:
                jsonschema.validate(instance=final_conf, schema=config_schema)
            except jsonschema.exceptions.ValidationError as exc:
                print(f"Validation failed: {exc.message}")
                sys.exit(1)

        final_conf["_enabled_capabilities"] = enabled_caps

        # Persist configuration.
        state.write_conf(self.group_name, instance_name, final_conf)

        # Run deployers.
        out_dir = os.path.join(self.group_dir, instance_name, BACKEND_DIR)
        os.makedirs(out_dir, exist_ok=True)

        env = Environment(loader=FileSystemLoader(pkg_dir))

        for dep_type, dep_config in manifest.get("deployers", {}).items():
            if dep_type == "docker-compose":
                deployer = DockerComposeDeployer(
                    dep_type, dep_config, pkg_dir, out_dir, env,
                    final_conf, self.global_conf, manifest, instance_name,
                )
                deployer.deploy(self.cap_manager)
            else:
                print(f"Warning: Unknown deployer '{dep_type}'.")

        # Register provided capabilities.
        for cap in manifest.get("capabilities", {}).get("provides", []):
            cap_name = cap.get("name")
            if cap_name:
                self.cap_manager.register(
                    cap_name, instance_name, cap.get("injectors", {}),
                )

    def resolve_instance(self, name):
        """Resolve a user-supplied name to an instance ID.

        Accepts either an exact instance ID or a package name (if
        unambiguous).

        Returns:
            The resolved instance ID string.

        Raises:
            SystemExit: If the name is ambiguous or not found.
        """
        # Exact directory match.
        if os.path.isdir(os.path.join(self.group_dir, name)):
            return name

        # Search by package name.
        matched = self._find_instances_by_package(name)

        if len(matched) == 1:
            return matched[0]
        if len(matched) > 1:
            print(f"Error: Multiple instances of '{name}' found: {matched}."
                  " Specify the exact instance ID.")
            sys.exit(1)
        print(f"Error: Instance or package '{name}' not found.")
        sys.exit(1)

    # -- internal helpers ---------------------------------------------------

    def _find_instances_by_package(self, pkg_name):
        """Return a list of instance IDs whose package matches ``pkg_name``."""
        if not os.path.isdir(self.group_dir):
            return []
        results = []
        for d in os.listdir(self.group_dir):
            st = state.read_state(self.group_name, d)
            if st and st.get("package") == pkg_name:
                results.append(d)
        return results

    def _resolve_instance_name(self, pkg_name, instance_id, reconfigure,
                               is_singleton, existing):
        """Determine the instance name for an install or reconfigure."""
        if instance_id:
            return instance_id

        if reconfigure:
            if len(existing) == 1:
                return existing[0]
            if len(existing) > 1:
                print(f"Error: Multiple instances of '{pkg_name}' exist."
                      f" Specify --id. Available: {existing}")
                sys.exit(1)
            print(f"Error: No instances of '{pkg_name}' to reconfigure.")
            sys.exit(1)

        # New install.
        if is_singleton and existing:
            print(f"Error: '{pkg_name}' is a singleton and already installed."
                  " Use 'reconfigure' to modify it.")
            sys.exit(1)

        return f"{pkg_name}-{uuid.uuid4().hex[:8]}"

    def _resolve_capabilities(self, consumes, pkg_conf,
                              reconfigure, non_interactive):
        """Interactively select capability providers.

        Args:
            consumes: Dict of ``{cap_name: cap_rules}`` from the manifest.
            pkg_conf: Previously saved config (may contain prior selections).
            reconfigure: Whether to re-prompt even if selections exist.
            non_interactive: If True, skip interactive prompts.

        Returns:
            Dict of ``{cap_name: [provider_id, ...]}``.
        """
        # Load prior selections.
        raw = pkg_conf.get("_enabled_capabilities", {})
        if isinstance(raw, list):
            enabled = {cap: list(self.cap_manager.get_providers(cap).keys())
                       for cap in raw}
        else:
            enabled = dict(raw)

        if non_interactive:
            return enabled

        for cap_name, cap_rules in consumes.items():
            providers = self.cap_manager.get_providers(cap_name)
            if not providers:
                continue

            prov_list = list(providers.keys())
            max_provs = cap_rules.get("max_providers")

            print(f"\nIntegration available: '{cap_name}'")
            if max_provs:
                print(f"(Max {max_provs} provider(s) allowed)")
            print("Available providers:")
            for idx, name in enumerate(prov_list):
                print(f"  {idx + 1}. {name}")

            # Compute default selection.
            default_sel = []
            if cap_name in enabled:
                default_sel = [
                    str(prov_list.index(p) + 1)
                    for p in enabled[cap_name]
                    if p in prov_list
                ]
            if not default_sel and not pkg_conf:
                if not (max_provs and max_provs < len(prov_list)):
                    default_sel = ["1"]
            default_str = ",".join(default_sel)

            if not (reconfigure or not pkg_conf):
                continue

            while True:
                ans = input(
                    "Select providers (comma-separated numbers, or empty"
                    f" to skip) [default: {default_str}]: "
                ).strip()
                if not ans and default_str:
                    ans = default_str

                selected = []
                if ans:
                    for part in ans.split(","):
                        part = part.strip()
                        if part.isdigit():
                            idx = int(part) - 1
                            if 0 <= idx < len(prov_list):
                                selected.append(prov_list[idx])

                if max_provs and len(selected) > max_provs:
                    print(f"Error: Max {max_provs} provider(s). Try again.")
                    continue

                if selected:
                    enabled[cap_name] = selected
                elif cap_name in enabled:
                    del enabled[cap_name]
                break

        return enabled


# ═══════════════════════════════════════════════════════════════════════════
# Helper Functions
# ═══════════════════════════════════════════════════════════════════════════

def _load_manifest(pkg_dir):
    """Load and return a package manifest, or ``None`` on failure."""
    path = os.path.join(pkg_dir, "manifest.yml")
    if not os.path.isfile(path):
        return None
    try:
        with open(path, "r") as fh:
            return yaml.safe_load(fh)
    except (yaml.YAMLError, OSError):
        return None


def _parse_consumes(manifest):
    """Normalize the ``capabilities.consumes`` field into a dict.

    The manifest supports two formats:
        consumes: [reverse-proxy]             # simple list of strings
        consumes:                             # list of dicts
          - name: reverse-proxy
            max_providers: 1

    Returns:
        Dict of ``{cap_name: cap_rules}``.
    """
    raw = manifest.get("capabilities", {}).get("consumes", [])
    result = {}
    if isinstance(raw, list):
        for entry in raw:
            if isinstance(entry, str):
                result[entry] = {}
            elif isinstance(entry, dict):
                name = entry.get("name", "")
                if name:
                    result[name] = {k: v for k, v in entry.items()
                                    if k != "name"}
    elif isinstance(raw, dict):
        result = raw
    return result


# ═══════════════════════════════════════════════════════════════════════════
# CLI Commands
# ═══════════════════════════════════════════════════════════════════════════

def cmd_install(args, engine):
    """Handle the ``install`` subcommand."""
    if args.id and len(args.packages) > 1:
        print("Error: --id cannot be used when installing multiple packages.")
        sys.exit(1)

    seen = []
    for pkg in args.packages:
        if pkg in seen:
            continue
        seen.append(pkg)

        pkg_dir = engine.find_package_dir(pkg, args.repo)
        cli_conf = {}
        if args.config:
            with open(args.config, "r") as fh:
                cli_conf = json.load(fh)
        engine.process_package(
            pkg_dir, cli_conf, args.reconfigure,
            args.non_interactive, args.id,
        )
        display_name = args.id if args.id else pkg
        print(f"Successfully installed {pkg} as {display_name}!\n")


def cmd_reconfigure(args, engine):
    """Handle the ``reconfigure`` subcommand."""
    if args.instance_ids:
        instances = [engine.resolve_instance(i) for i in args.instance_ids]
    else:
        instances = os.listdir(engine.group_dir) if os.path.isdir(engine.group_dir) else []

    count = 0
    for instance_id in instances:
        st = state.read_state(engine.group_name, instance_id)
        if st is None:
            continue
        pkg_name = st.get("package")
        if not pkg_name:
            continue
        try:
            pkg_dir = engine.find_package_dir(pkg_name)
            is_interactive = bool(args.instance_ids)
            engine.process_package(
                pkg_dir, cli_conf={},
                reconfigure=is_interactive,
                non_interactive=not is_interactive,
                instance_id=instance_id,
            )
            count += 1
        except SystemExit:
            print(f"Warning: Could not reconfigure '{pkg_name}'"
                  f" (instance '{instance_id}').")
    print(f"Successfully reconfigured {count} instance(s)"
          f" in group '{engine.group_name}'.")


def cmd_remove(args, engine):
    """Handle the ``remove`` subcommand."""
    real_ids = [engine.resolve_instance(i) for i in args.instance_ids]

    # Check for dependents.
    deps = _find_dependents(engine, real_ids)

    if deps:
        all_dependents = []
        for provider_id, dependents in deps.items():
            print(f"Warning: '{provider_id}' is used by:"
                  f" {', '.join(dependents)}")
            for d in dependents:
                if d not in all_dependents:
                    all_dependents.append(d)

        if args.cascade:
            ans = "y"
        else:
            ans = input(
                "Reconfigure these instances to remove the integration"
                " and restart? [y/N]: "
            ).strip().lower()

        if ans == "y":
            for dep_id in all_dependents:
                _cascade_remove_integration(engine, dep_id, real_ids)
        else:
            print("Aborting removal.")
            sys.exit(1)

    # Remove each instance.
    for real_id in real_ids:
        print(f"Stopping instance '{real_id}'...")
        try:
            subprocess.run(
                ["stegctl", "--group", engine.group_name, "stop", real_id],
                check=True,
            )
        except subprocess.CalledProcessError:
            print("Warning: Failed to stop instance cleanly."
                  " Proceeding with removal...")

        instance_dir = os.path.join(engine.group_dir, real_id)

        if args.purge:
            if os.path.exists(instance_dir):
                shutil.rmtree(instance_dir)
            print(f"Removed '{real_id}' and all persistent data.")
        else:
            backend_dir = os.path.join(instance_dir, BACKEND_DIR)
            for fname in [".stegpkg-state.json", "docker-compose.yml"]:
                fpath = os.path.join(backend_dir, fname)
                if os.path.exists(fpath):
                    os.remove(fpath)
            print(f"Uninstalled '{real_id}'. Config and data preserved.")


def cmd_upgrade(args, engine):
    """Handle the ``upgrade`` subcommand."""
    if args.instance_ids:
        instances = [engine.resolve_instance(i) for i in args.instance_ids]
    else:
        instances = os.listdir(engine.group_dir) if os.path.isdir(engine.group_dir) else []

    count = 0
    for instance_id in instances:
        st = state.read_state(engine.group_name, instance_id)
        if st is None:
            continue
        pkg_name = st.get("package")
        if not pkg_name:
            continue
        try:
            pkg_dir = engine.find_package_dir(pkg_name)
            engine.process_package(
                pkg_dir, cli_conf={}, reconfigure=False,
                non_interactive=True, instance_id=instance_id,
            )
            print(f"[{instance_id}] Ensuring instance is up to date...")
            subprocess.run(
                ["stegctl", "--group", engine.group_name, "apply", instance_id],
                check=True,
            )
            count += 1
        except (SystemExit, subprocess.CalledProcessError, OSError) as exc:
            print(f"Warning: Could not upgrade '{pkg_name}'"
                  f" (instance '{instance_id}'): {exc}")
    print(f"Upgraded {count} instance(s) in group '{engine.group_name}'.")


def cmd_update(args, engine):
    """Handle the ``update`` subcommand (git pull repos)."""
    if not os.path.isdir(engine.repo_dir):
        print(f"Error: Repos directory '{engine.repo_dir}' does not exist.")
        sys.exit(1)

    count = 0
    for name in os.listdir(engine.repo_dir):
        repo_path = os.path.join(engine.repo_dir, name)
        if not os.path.isdir(os.path.join(repo_path, ".git")):
            print(f"[{name}] Skipping (not a git repository).")
            continue
        print(f"[{name}] Pulling from remote...")
        try:
            subprocess.run(
                ["git", "config", "--global", "--add",
                 "safe.directory", repo_path],
                check=True, capture_output=True,
            )
            subprocess.run(
                ["git", "pull", "--rebase", "--autostash"],
                cwd=repo_path, check=True,
            )
            count += 1
        except subprocess.CalledProcessError:
            print(f"Warning: Failed to update '{name}'.")
    print(f"Updated {count} repository(ies).")


def cmd_list(args, engine):
    """Handle the ``list`` subcommand."""
    if not os.path.isdir(engine.group_dir):
        print(f"No packages installed in group '{engine.group_name}'.")
        return

    print(f"Installed packages in group '{engine.group_name}':")
    count = 0
    for instance_id in sorted(os.listdir(engine.group_dir)):
        st = state.read_state(engine.group_name, instance_id)
        if st is None:
            continue
        pkg_name = st.get("package", "unknown")
        print(f"  - {instance_id} (Package: {pkg_name})")
        count += 1

    if count == 0:
        print("  (none)")


def cmd_clean(args, engine):
    """Handle the ``clean`` subcommand to delete unmanaged data directories."""
    if not os.path.isdir(engine.group_dir):
        print(f"Group directory '{engine.group_dir}' does not exist.")
        return

    unmanaged = []
    for name in os.listdir(engine.group_dir):
        if name in [GLOBAL_CONF_FILENAME, ".docker-cache"]:
            continue
        path = os.path.join(engine.group_dir, name)
        if not os.path.isdir(path):
            continue
        
        st = state.read_state(engine.group_name, name)
        if st is None:
            unmanaged.append(path)

    if not unmanaged:
        print(f"No unmanaged directories found in group '{engine.group_name}'.")
        return

    print("Found unmanaged directories:")
    for path in unmanaged:
        print(f"  - {path}")

    if args.yes:
        ans = "y"
    else:
        ans = input("Delete these directories permanently? [y/N]: ").strip().lower()

    if ans == "y":
        count = 0
        for path in unmanaged:
            try:
                shutil.rmtree(path)
                print(f"Deleted {path}")
                count += 1
            except OSError as e:
                print(f"Failed to delete {path}: {e}")
        print(f"Successfully cleaned {count} directory(ies).")
    else:
        print("Aborted.")


# ═══════════════════════════════════════════════════════════════════════════
# Remove helpers
# ═══════════════════════════════════════════════════════════════════════════

def _find_dependents(engine, target_ids):
    """Find instances that depend on any of ``target_ids`` via capabilities.

    Returns:
        Dict of ``{provider_id: [dependent_id, ...]}``.
    """
    deps = {}
    if not os.path.isdir(engine.group_dir):
        return deps

    for d in os.listdir(engine.group_dir):
        if d in target_ids:
            continue
        st = state.read_state(engine.group_name, d)
        if st is None:
            continue
        for _cap, provs in st.get("enabled_caps", {}).items():
            if isinstance(provs, list):
                for p in provs:
                    if p in target_ids:
                        deps.setdefault(p, []).append(d)
            elif provs in target_ids:
                deps.setdefault(provs, []).append(d)
    return deps


def _cascade_remove_integration(engine, dep_id, removed_ids):
    """Reconfigure a dependent instance to drop integrations to removed IDs."""
    print(f"[{dep_id}] Reconfiguring to remove integrations...")
    conf = state.read_conf(engine.group_name, dep_id)
    enabled = conf.get("_enabled_capabilities", {})

    for cap, provs in list(enabled.items()):
        if isinstance(provs, list):
            new = [p for p in provs if p not in removed_ids]
            if not new:
                del enabled[cap]
            else:
                enabled[cap] = new
        elif provs in removed_ids:
            del enabled[cap]

    state.write_conf(engine.group_name, dep_id, conf)

    st = state.read_state(engine.group_name, dep_id)
    if st:
        pkg_name = st.get("package")
        if pkg_name:
            try:
                pkg_dir = engine.find_package_dir(pkg_name)
                engine.process_package(
                    pkg_dir, cli_conf={}, reconfigure=False,
                    non_interactive=True, instance_id=dep_id,
                )
                print(f"[{dep_id}] Restarting...")
                subprocess.run(
                    ["stegctl", "--group", engine.group_name, "start", dep_id],
                    check=True,
                )
            except (SystemExit, subprocess.CalledProcessError):
                print(f"Warning: Failed to reconfigure '{dep_id}'.")


# ═══════════════════════════════════════════════════════════════════════════
# Entrypoint
# ═══════════════════════════════════════════════════════════════════════════

def main():
    """Parse arguments and dispatch to the appropriate command handler."""
    parser = argparse.ArgumentParser(
        description="stegOS Package Manager",
    )
    parser.add_argument(
        "--version", action="version", version=f"stegpkg {VERSION}",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # -- install ------------------------------------------------------------
    p = subparsers.add_parser("install", help="Install a package")
    p.add_argument("packages", nargs="+", help="Package(s) to install")
    p.add_argument("--id", help="Explicit instance ID")
    p.add_argument("--group", help="Target group")
    p.add_argument("--repo", help="Disambiguate by repository name")
    p.add_argument("--config", help="Path to JSON config overrides")
    p.add_argument("--reconfigure", action="store_true",
                   help="Re-prompt for all values")
    p.add_argument("--non-interactive", action="store_true",
                   help="Never prompt; use defaults or abort")

    # -- reconfigure --------------------------------------------------------
    p = subparsers.add_parser("reconfigure",
                              help="Regenerate configuration")
    p.add_argument("instance_ids", nargs="*",
                   help="Instance(s) to reconfigure (default: all)")
    p.add_argument("--group", help="Target group")

    # -- remove -------------------------------------------------------------
    p = subparsers.add_parser("remove", help="Remove a package instance")
    p.add_argument("instance_ids", nargs="+", help="Instance(s) to remove")
    p.add_argument("--group", help="Target group")
    p.add_argument("--purge", action="store_true",
                   help="Also delete persistent data")
    p.add_argument("--cascade", action="store_true",
                   help="Auto-reconfigure dependents")

    # -- upgrade ------------------------------------------------------------
    p = subparsers.add_parser("upgrade",
                              help="Upgrade packages")
    p.add_argument("instance_ids", nargs="*",
                   help="Instance(s) to upgrade (default: all)")
    p.add_argument("--group", help="Target group")

    # -- update -------------------------------------------------------------
    p = subparsers.add_parser("update",
                              help="Update app repositories via git pull")
    p.add_argument("--group", help="Target group")

    # -- list ---------------------------------------------------------------
    p = subparsers.add_parser("list", help="List installed packages")
    p.add_argument("--group", help="Target group")

    # -- clean --------------------------------------------------------------
    p = subparsers.add_parser("clean", help="Remove unmanaged instance directories")
    p.add_argument("--group", help="Target group")
    p.add_argument("-y", "--yes", action="store_true", help="Automatic yes to prompts")

    args = parser.parse_args()
    engine = PackageEngine(args.group)

    commands = {
        "install": cmd_install,
        "reconfigure": cmd_reconfigure,
        "remove": cmd_remove,
        "upgrade": cmd_upgrade,
        "update": cmd_update,
        "list": cmd_list,
        "clean": cmd_clean,
    }
    commands[args.command](args, engine)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nAborted by user.")
        sys.exit(130)
