#!/usr/bin/env python3
import argparse
import json
import logging
import sys

from steglib.server import StegServerApp
from steglib.daemon_api import create_dispatcher

app = StegServerApp()
dispatcher = create_dispatcher()

import contextvars
request_send_fn = contextvars.ContextVar('request_send_fn', default=None)

class ContextRoutingHandler(logging.Handler):
    def emit(self, record):
        send_fn = request_send_fn.get()
        if send_fn:
            try:
                msg = self.format(record)
                send_fn({"type": "log", "message": msg, "levelno": record.levelno})
            except Exception:
                self.handleError(record)

# Setup global routing handler once
routing_handler = ContextRoutingHandler()
routing_handler.setFormatter(logging.Formatter('%(message)s'))
logging.getLogger().addHandler(routing_handler)
logging.getLogger().setLevel(logging.DEBUG)

@app.on_stream()
def handle_stream(rfile, wfile):
    def send(msg):
        wfile.write((json.dumps(msg) + "\n").encode("utf-8"))
        wfile.flush()

    request_send_fn.set(send)

    line = rfile.readline()
    if not line:
        return
    req = json.loads(line)
    action = req.get("action")
    args = req.get("args", {})
    group = args.get("group")

    def interactive_cb(message, prompt_type="text", choices=None, default=None, multiple=False, **kwargs):
        send({"type": "prompt", "prompt_type": prompt_type, "message": message, "choices": choices, "default": default, "multiple": multiple, **kwargs})
        ans_line = rfile.readline()
        if not ans_line:
            return default
        ans = json.loads(ans_line)
        return ans.get("answer")
        
    try:
        result = dispatcher.dispatch(action, args, interactive_cb, send)
        send({"type": "done", "result": result if result is not None else "Success"})
    except Exception as e:
        resp = {"type": "error", "error": str(e)}
        if hasattr(e, "details"):
            resp["details"] = e.details
        send(resp)

def main():
    parser = argparse.ArgumentParser(description="stegOS Daemon")
    parser.add_argument("--unix-socket", default="/run/stegos/stegos.sock", help="Path to the Unix socket to listen on")
    parser.add_argument("--tcp-port", type=int, help="TCP port to listen on (optional)")
    parser.add_argument("--tcp-host", default="0.0.0.0", help="TCP host")
    args = parser.parse_args()

    logging.basicConfig(level=logging.INFO, format="%(message)s")

    if args.tcp_port:
        app.serve_tcp(args.tcp_host, args.tcp_port)
    else:
        app.serve_unix(args.unix_socket)

if __name__ == "__main__":
    main()
