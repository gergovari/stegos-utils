#!/bin/sh
### BEGIN INIT INFO
# Provides:          stegd
# Required-Start:    $syslog $local_fs
# Required-Stop:     $syslog $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: stegOS Daemon
### END INIT INFO

DAEMON=/usr/bin/stegd
NAME=stegd
PIDFILE=/var/run/$NAME.pid

case "$1" in
  start)
    echo -n "Starting stegOS Daemon: "
    PYTHONUNBUFFERED=1 nohup /usr/bin/python3 $DAEMON --unix-socket /run/stegos/stegos.sock </dev/null > /var/log/stegd.log 2>&1 &
    echo $! > $PIDFILE
    
    # Wait for the daemon to be up
    for i in $(seq 1 15); do
        if [ -S /run/stegos/stegos.sock ]; then
            break
        fi
        sleep 1
    done
    if [ ! -S /run/stegos/stegos.sock ]; then
        echo "failed (socket timeout)."
        exit 1
    fi
    echo "done."
    ;;
  stop)
    echo -n "Stopping stegOS Daemon: "
    if [ -f $PIDFILE ]; then
      kill $(cat $PIDFILE)
      rm -f $PIDFILE
    fi
    echo "done."
    ;;
  restart|force-reload)
    $0 stop
    sleep 1
    $0 start
    ;;
  status)
    if [ -f $PIDFILE ] && kill -0 $(cat $PIDFILE) 2>/dev/null; then
        echo "stegd is running"
    else
        echo "stegd is stopped"
    fi
    ;;
  *)
    echo "Usage: /etc/init.d/$NAME {start|stop|restart|force-reload|status}"
    exit 1
    ;;
esac

exit 0
